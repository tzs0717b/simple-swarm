# 服务端口（默认 8787，不占用特权端口）
PORT=8787
# 监听地址：本地开发用 127.0.0.1；服务器对外用 0.0.0.0
HOST=0.0.0.0
# 数据目录（事件日志 + 快照）。默认 ./data；服务器建议 /var/lib/simple-swarm
SWARM_HOME=./data
# 首次启动且事件库为空时自动播种演示数据（1=开 0=关）
SEED_ON_BOOT=1
# 本地无 API key 时走假模型，前后端联调不依赖外部服务
MOCK_LLM=1
# 真模型 key 只放在服务端，agent worker 永远拿不到
# DEEPSEEK_API_KEY=
