# ── 必需：一个 OpenAI 兼容的 /chat/completions 端点 ──
# 这三行就够了。任何兼容端点都行：OpenAI / DeepSeek / OpenRouter / Ollama / vLLM /
# litellm / new-api / 你自建的 keypool。
LLM_BASE_URL=https://api.deepseek.com/v1
LLM_API_KEY=sk-替换成你的key
# 注意：默认值 auto 是本项目自建 keypool 的专有别名；用别家端点必须写真实模型名。
LLM_MODEL=deepseek-chat

# ── 可选：故障转移（逗号分隔，主模型连续失败后自动换）──
# LLM_FALLBACK_MODELS=deepseek-reasoner,qwen-max

# ── 可选：一次运行的墙钟上限与预算 ──
SWARM_RUN_MAX_MS=1800000
SWARM_DEFAULT_BUDGET=8
SWARM_MAX_AGENTS=10

# ── 可选：派工员（把目标切成可认领的片）用哪个模型 ──
# SWARM_SLICER_MODEL=deepseek-chat

# ── keypool 专用（留空即完全不用 keypool）──
# KEYPOOL_ADMIN_URL=http://127.0.0.1:3131
# KEYPOOL_PROXY_TOKEN=
# KEYPOOL_LANE_PREFER=
# KEYPOOL_LANE_DENY=
